            "format": "int32"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "apiKey",
        "description": "Introduce el token JWT con el prefijo 'Bearer'.",
        "name": "Authorization",
