          "author",
          "category",
          "isbn",
          "stock",
          "title"
        ],
        "type": "object",
        "properties": {
          "title": {
            "minLength": 1,
            "type": "string"
          },
          "author": {
            "minLength": 1,
            "type": "string"
          },
          "editorial": {
            "type": "string",
            "nullable": true
          },
