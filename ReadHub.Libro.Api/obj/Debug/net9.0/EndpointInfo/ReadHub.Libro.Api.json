  "components": {
    "schemas": {
      "ApprovePendingLoanDto": {
        "required": [
          "approvedQuantity",
          "pendingLoanId"
        ],
        "type": "object",
        "properties": {
          "pendingLoanId": {
            "type": "string",
            "format": "uuid"
          },
          "approvedQuantity": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "BookDto": {
        "required": [
          "author",
          "category",
          "isbn",
          "stock",
          "title"
        ],
        "type": "object",
        "properties": {
          "title": {
            "minLength": 1,
            "type": "string"
          },
          "author": {
            "minLength": 1,
            "type": "string"
          },
          "editorial": {
            "type": "string",
            "nullable": true
          },
          "year": {
            "type": "integer",
            "format": "int32"
          },
          "category": {
            "minLength": 1,
            "type": "string"
          },
          "isbn": {
            "minLength": 1,
            "type": "string"
          },
          "stock": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CreateLoanDto": {
        "required": [
          "books",
          "userId"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "loanDays": {
            "type": "integer",
            "format": "int32"
          },
          "books": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LoanBookItemDto"
            }
          }
        },
        "additionalProperties": false
      },
      "CreatePendingLoanDto": {
        "required": [
          "books",
          "userId"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "returnDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "books": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PendingLoanBookItemDto"
            }
          }
        },
        "additionalProperties": false
      },
      "LoanBookItemDto": {
        "type": "object",
        "properties": {
          "bookId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "PendingLoanBookItemDto": {
        "required": [
          "bookId",
          "requestedQuantity"
        ],
        "type": "object",
        "properties": {
          "bookId": {
            "type": "string",
            "format": "uuid"
          },
          "requestedQuantity": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "RenewLoanDto": {
        "type": "object",
        "properties": {
          "loanId": {
            "type": "string",
            "format": "uuid"
          },
          "extraDays": {
            "maximum": 30,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "ReturnLoanItemRequest": {
        "type": "object",
        "properties": {
          "quantity": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "apiKey",
        "description": "Introduce el token JWT con el prefijo 'Bearer'.",
        "name": "Authorization",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
